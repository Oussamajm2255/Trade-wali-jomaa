# Copy this file to .env and fill in your values.
# PowerShell: Copy-Item .env.example .env
# NEVER commit .env — it is gitignored.

# --- DeepSeek LLM ---
# Your key from platform.deepseek.com. Leave empty to run in
# "heuristic fallback" mode (deterministic signals only, no LLM).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Use the exact model ID your DeepSeek account offers
# (e.g. deepseek-chat or deepseek-reasoner).
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2

# --- Market data (public endpoints only — no private keys needed for paper) ---
EXCHANGE_ID=binance
# Crypto watchlist. For gold, use: SYMBOLS=XAUUSD
# (XAUUSD uses COMEX futures data with PAXG/USDT fallback — no exchange key needed)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
OHLCV_LIMIT=300

# --- Storage ---
DATABASE_URL=sqlite:///trading.db

# --- Execution mode ---
# paper = simulated fills on real market data (default, safe)
# mt5   = REAL orders via MetaTrader 5 (IC Markets, FTMO, any MT5 broker)
EXECUTION_MODE=paper
# mt5 mode refuses to start unless this is explicitly true.
LIVE_ACKNOWLEDGED=false

# --- MetaTrader 5 (only when EXECUTION_MODE=mt5) ---
# IC Markets demo: MT5_SERVER=ICMarketsSC-Demo (use the exact name from
# your MT5 login window; FTMO works identically with its own server name).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=ICMarketsSC-Demo
# Optional: path to terminal64.exe (auto-detected when empty)
MT5_PATH=
MT5_MAGIC=770313
MT5_DEVIATION_POINTS=20
# Dollar Index CFD symbol on your MT5 server (contract suffix changes monthly,
# e.g. DXY_U6 = September contract — check Market Watch for the current one)
MT5_DXY_SYMBOL=DXY_U6

# --- DXY concurrency filter (gold) ---
# The heart of the strategy: BUY gold only when the dollar is weak,
# SELL only when the dollar is strong. Gauge: 100 = USD weak (bullish gold).
DXY_FILTER_ENABLED=true
DXY_LONG_MIN=55
DXY_SHORT_MAX=45

# --- Notifications (Telegram) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here
# 2. Message your bot (/start), then run:
#    python -m trading_agent.main telegram-chatid
# 3. Put the printed chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Refusal alerts (§38): every rejected signal + its gate reason goes to
# Telegram. ON by default — a refusal is trader intelligence (why not to
# put money). Consecutive refusals by the SAME gate are deduplicated:
# one availability heartbeat per TELEGRAM_REJECTION_REPEAT_MINUTES
# instead of one message per 15m cycle.
# TELEGRAM_REJECTION_ALERTS=true
# TELEGRAM_REJECTION_REPEAT_MINUTES=60

# --- Trading sessions (analysis gate) ---
# Analysis runs only while London, New York or Sydney is open (LOCAL
# times, summer/winter handled automatically). Position management stays
# 24/7. Set SESSION_SYDNEY="" to disable the Sydney gate.
SESSION_FILTER_ENABLED=true
SESSION_LONDON=08:00-17:00
SESSION_NEW_YORK=09:30-17:00
SESSION_SYDNEY=07:00-16:00

# --- Multi-timeframe (pro logic) ---
# TIMEFRAME = ENTRY timeframe (15m: triggers, stops, targets).
# HTF_TIMEFRAME = ANALYSIS timeframe (4h: directional bias).
# LONG only in an HTF uptrend, SHORT only in an HTF downtrend;
# a choppy HTF (ADX < HTF_ADX_MIN) blocks all trades.
HTF_TIMEFRAME=4h
HTF_BIAS_FILTER_ENABLED=true
HTF_ADX_MIN=20

# --- DeepSeek balance monitoring ---
# Checked once per UTC day; Telegram alert when balance < this (USD).
DEEPSEEK_BALANCE_WARN_USD=1

# --- Canonical snapshot & data quality (INTELLIGENCE_V2) ---
# Entry TF + these higher TFs form ONE coherent snapshot per cycle.
SNAPSHOT_TIMEFRAMES=["1h","4h","1d"]
# FAIL stops the cycle (no AI calls, no proposal); DEGRADED continues
# only when allowed below, and is labelled/stored on every signal.
DATA_QUALITY_MIN_CANDLES=60
DATA_QUALITY_MAX_STALE_MULTIPLE=3
DATA_QUALITY_ALLOW_DEGRADED=true
# Phase A: market timestamps ahead of the local clock beyond this many
# seconds degrade data quality (provider/clock skew).
DATA_CLOCK_TOLERANCE_S=60
DXY_MAX_AGE_HOURS=48

# --- Deterministic regime / structure / session context (phase 2) ---
# Regime engine: TREND_UP / TREND_DOWN / RANGE / HIGH_VOLATILITY /
# LOW_VOLATILITY / TRANSITION from ADX, ATR behaviour, EMA alignment.
REGIME_ADX_TREND=25
REGIME_ATR_HIGH_MULT=1.8
REGIME_ATR_LOW_MULT=0.55
# Market structure / SMC: swings, BOS/CHoCH, equal highs/lows, sweeps,
# FVGs, displacement + order-block candidates.
STRUCTURE_SWING_LEFT=3
STRUCTURE_SWING_RIGHT=3
STRUCTURE_TOLERANCE_PCT=0.05
STRUCTURE_FVG_MIN_ATR_MULT=0.3
STRUCTURE_DISPLACEMENT_ATR_MULT=1.5
STRUCTURE_SWEEP_LOOKBACK=30
# Session CLASSIFICATION (informational, stored with every signal):
# ASIA / SYDNEY / LONDON / LONDON_NY_OVERLAP / NEW_YORK / OFF_SESSION.
# ASIA window is in Tokyo local time; it never gates analysis.
SESSION_ASIA=09:00-18:00

# --- Risk (paper) ---
PAPER_STARTING_EQUITY=10000
RISK_PER_TRADE=0.01
MAX_POSITIONS=3
MAX_EXPOSURE=0.25
DAILY_LOSS_LIMIT=0.03
MAX_DRAWDOWN=0.10
ATR_STOP_MULT=2.0
TAKE_PROFIT_RR=2.0
MIN_CONFIDENCE=0.55
FEE_RATE=0.001
SLIPPAGE=0.0005

# --- Signal fusion weights ---
WEIGHT_TECHNICAL=0.45
WEIGHT_REGIME=0.35
# On gold this weight applies to the DXY context agent (spec §14).
WEIGHT_SENTIMENT=0.20
SIDE_THRESHOLD=0.25

# --- AI failure isolation & reliability (phase 3, spec §15/§37) ---
# A failed agent = LLM call failed (TIMEOUT/INVALID_JSON/API_ERROR/
# RATE_LIMIT/EMPTY_RESPONSE) and its heuristic fallback was used.
# 0 failed = normal, 1 = degraded warning, >= AGENT_FAILURE_BLOCK_MIN
# = no new proposals. LLM disabled by config is NOT a failure.
AGENT_FAILURE_BLOCK_ENABLED=true
AGENT_FAILURE_BLOCK_MIN=2
# Rolling window for per-agent reliability stats (analysis-only, weights
# are never modified from it). View with: python -m trading_agent.main agent-stats
AGENT_RELIABILITY_WINDOW=200

# --- Setup quality engine (phase 4, spec §18) ---
# Deterministic 7-component score (mtf_alignment/structure/regime/dxy/
# volatility/session/risk_reward); proposals below this are refused as
# no-trade LOW_SETUP_QUALITY.
SETUP_QUALITY_MIN=0.45

# --- Conflict detection (phase 4, spec §19) ---
# >= CONFLICT_CONFLICTED_MIN contradictions -> CONFLICTED (blocked by
# default). MIXED always reduces setup quality by
# CONFLICT_PENALTY_PER_AXIS per conflict (capped at CONFLICT_MAX_PENALTY).
CONFLICT_CONFLICTED_MIN=2
CONFLICT_BLOCK_CONFLICTED=true
CONFLICT_PENALTY_PER_AXIS=0.15
CONFLICT_MAX_PENALTY=0.4

# --- No-trade gates (phase 4, spec §20) ---
# HIGH_VOLATILITY is opt-in. BAD_SPREAD only fires when a spread is
# supplied and the threshold > 0. STATISTICAL_EDGE_UNKNOWN must stay off
# until the phase-5 outcome engine produces calibrated confidence.
NO_TRADE_HIGH_VOLATILITY=false
NO_TRADE_MAX_SPREAD_PCT=0
REQUIRE_STATISTICAL_EDGE=false

# --- Confidence calibration (phase 4, spec §21) ---
# calibrated_confidence = historical win rate inside the signal's own
# 0.05-wide raw-confidence bucket, and only once BOTH sample minimums
# hold; otherwise it is reported as n/a.
CALIBRATION_WINDOW=500
CALIBRATION_MIN_SAMPLES=50
CALIBRATION_MIN_PER_BIN=10

# --- Historical backtesting (phase 5, spec §24/§25) ---
# Candle-by-candle replay; isolated database; deterministic (no LLM calls).
# Run: python -m trading_agent.main backtest XAUUSD --tf 15m --start 2026-06-01
BACKTEST_HISTORY_LIMIT=5000
BACKTEST_DB_URL=sqlite:///backtest.db
BACKTEST_SPREAD_PCT=0.0
